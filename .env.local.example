# ─── OpenAI (clasificación IA de noticias) ────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ─── Vercel Blob (almacenamiento de presentaciones) ───────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Supabase (acceso directo desde cliente si se usa Supabase Auth) ───────
